# URL da API do backend (termina em /api). Em desenvolvimento use o backend local.
# Em produção o build usa o arquivo .env.production (ou a variável da Vercel, que tem prioridade).
VITE_API_URL=http://localhost:3000/api

# Conta de demonstração (botão "Entrar com conta demo" no login). Deixe vazio para ocultar.
VITE_DEMO_EMAIL=
VITE_DEMO_PASSWORD=
